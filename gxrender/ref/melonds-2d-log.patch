+// gxrender 2D-state capture (see gxrender/ref/melonds-2d-log.patch and
+// GX_TRACES.md): declared here instead of GPU3D.h to keep this file's
+// include set unchanged.
 namespace melonDS
 {
+namespace GXLog
+{
+void Dump2D(const void* state, u32 size) noexcept;
+void DumpScreens(const void* fb0, const void* fb1) noexcept;
+int PendingUnit() noexcept;
+bool Active() noexcept;
+bool TwoDActive() noexcept;
+}
+}
+
+namespace melonDS
+{
+
+// ---------------------------------------------------------------------------
+// GX2D state image assembly.  Fixed little-endian layout (host is LE),
+// GX2D_STATE_SIZE bytes; mirrored by gxrender/src/gx_2d.h:
+//   0x00000  256  engine A regs block      (layout below)
+//   0x00100  256  engine B regs block
+//   0x00200  512  global regs block
+//   0x00400 2048  palette RAM
+//   0x00C00 2048  OAM
+//   0x01400 512K  VRAMFlat_ABG
+//   0x81400 128K  VRAMFlat_BBG
+//   0xA1400 256K  VRAMFlat_AOBJ
+//   0xE1400 128K  VRAMFlat_BOBJ
+//   0x101400  32K VRAMFlat_ABGExtPal
+//   0x109400  32K VRAMFlat_BBGExtPal
+//   0x111400   8K VRAMFlat_AOBJExtPal
+//   0x113400   8K VRAMFlat_BOBJExtPal
+//   0x115400 512K VRAM_A..D raw banks (VRAM display / capture sources)
+// Engine regs block: +0x00 dispcnt u32, +0x04 bgcnt[4] u16, +0x0C bgxpos[4],
+// +0x14 bgypos[4], +0x1C bgxref[2] s32, +0x24 bgyref[2], +0x2C bgxrefreload[2],
+// +0x34 bgyrefreload[2], +0x3C bgrota[2] s16, +0x40 bgrotb[2], +0x44 bgrotc[2],
+// +0x48 bgrotd[2], +0x4C win0coords[4] u8, +0x50 win1coords[4], +0x54 wincnt[4],
+// +0x58 bgmosaicsize[2], +0x5A objmosaicsize[2], +0x5C blendcnt u16,
+// +0x5E blendalpha u16, +0x60 eva/evb/evy u8, +0x63 win0active, +0x64 win1active.
+// Global block: +0x00 masterbright A/B u16, +0x04 screens_enabled,
+// +0x05 screen_swap, +0x06 engA_enabled, +0x07 engB_enabled, +0x08 VRAMCNT[9],
+// +0x11 VRAMSTAT, +0x12 capture_enable, +0x14 capturecnt u32,
+// +0x18 dispfifobuffer[256] u16.
+// ---------------------------------------------------------------------------
+constexpr u32 GX2D_STATE_SIZE = 0x195400;
+
+static inline void GXP16(u8* p, u16 v) { memcpy(p, &v, 2); }
+static inline void GXP32(u8* p, u32 v) { memcpy(p, &v, 4); }
+
+static void GXLogDumpEngine(u8* dst, const GPU2D& e)
+{
+    GXP32(dst + 0x00, e.DispCnt);
+    for (int i = 0; i < 4; i++) GXP16(dst + 0x04 + i * 2, e.BGCnt[i]);
+    for (int i = 0; i < 4; i++) GXP16(dst + 0x0C + i * 2, e.BGXPos[i]);
+    for (int i = 0; i < 4; i++) GXP16(dst + 0x14 + i * 2, e.BGYPos[i]);
+    for (int i = 0; i < 2; i++) GXP32(dst + 0x1C + i * 4, (u32)e.BGXRef[i]);
+    for (int i = 0; i < 2; i++) GXP32(dst + 0x24 + i * 4, (u32)e.BGYRef[i]);
+    for (int i = 0; i < 2; i++) GXP32(dst + 0x2C + i * 4, (u32)e.BGXRefReload[i]);
+    for (int i = 0; i < 2; i++) GXP32(dst + 0x34 + i * 4, (u32)e.BGYRefReload[i]);
+    for (int i = 0; i < 2; i++) GXP16(dst + 0x3C + i * 2, (u16)e.BGRotA[i]);
+    for (int i = 0; i < 2; i++) GXP16(dst + 0x40 + i * 2, (u16)e.BGRotB[i]);
+    for (int i = 0; i < 2; i++) GXP16(dst + 0x44 + i * 2, (u16)e.BGRotC[i]);
+    for (int i = 0; i < 2; i++) GXP16(dst + 0x48 + i * 2, (u16)e.BGRotD[i]);
+    memcpy(dst + 0x4C, e.Win0Coords, 4);
+    memcpy(dst + 0x50, e.Win1Coords, 4);
+    memcpy(dst + 0x54, e.WinCnt, 4);
+    dst[0x58] = e.BGMosaicSize[0]; dst[0x59] = e.BGMosaicSize[1];
+    dst[0x5A] = e.OBJMosaicSize[0]; dst[0x5B] = e.OBJMosaicSize[1];
+    GXP16(dst + 0x5C, e.BlendCnt);
+    GXP16(dst + 0x5E, e.BlendAlpha);
+    dst[0x60] = e.EVA; dst[0x61] = e.EVB; dst[0x62] = e.EVY;
+    dst[0x63] = e.Win0Active; dst[0x64] = e.Win1Active;
+}
+
+static void GXLogDump2DState(melonDS::GPU& gpu)
+{
+    static std::vector<u8> buf(GX2D_STATE_SIZE);
+    u8* s = buf.data();
+
+    // make all 2D flat views coherent (same dance as SoftRenderer2D::DrawScanline)
+    auto d1 = gpu.VRAMDirty_ABG.DeriveState(gpu.VRAMMap_ABG, gpu);
+    gpu.MakeVRAMFlat_ABGCoherent(d1);
+    auto d2 = gpu.VRAMDirty_BBG.DeriveState(gpu.VRAMMap_BBG, gpu);
+    gpu.MakeVRAMFlat_BBGCoherent(d2);
+    auto d3 = gpu.VRAMDirty_AOBJ.DeriveState(gpu.VRAMMap_AOBJ, gpu);
+    gpu.MakeVRAMFlat_AOBJCoherent(d3);
+    auto d4 = gpu.VRAMDirty_BOBJ.DeriveState(gpu.VRAMMap_BOBJ, gpu);
+    gpu.MakeVRAMFlat_BOBJCoherent(d4);
+    auto d5 = gpu.VRAMDirty_ABGExtPal.DeriveState(gpu.VRAMMap_ABGExtPal, gpu);
+    gpu.MakeVRAMFlat_ABGExtPalCoherent(d5);
+    auto d6 = gpu.VRAMDirty_BBGExtPal.DeriveState(gpu.VRAMMap_BBGExtPal, gpu);
+    gpu.MakeVRAMFlat_BBGExtPalCoherent(d6);
+    auto d7 = gpu.VRAMDirty_AOBJExtPal.DeriveState(&gpu.VRAMMap_AOBJExtPal, gpu);
+    gpu.MakeVRAMFlat_AOBJExtPalCoherent(d7);
+    auto d8 = gpu.VRAMDirty_BOBJExtPal.DeriveState(&gpu.VRAMMap_BOBJExtPal, gpu);
+    gpu.MakeVRAMFlat_BOBJExtPalCoherent(d8);
+
+    memset(s, 0, GX2D_STATE_SIZE);
+    GXLogDumpEngine(s + 0x00000, gpu.GPU2D_A);
+    GXLogDumpEngine(s + 0x00100, gpu.GPU2D_B);
+
+    u8* g = s + 0x00200;
+    GXP16(g + 0x00, gpu.MasterBrightnessA);
+    GXP16(g + 0x02, gpu.MasterBrightnessB);
+    g[0x04] = gpu.ScreensEnabled ? 1 : 0;
+    g[0x05] = gpu.ScreenSwap ? 1 : 0;
+    g[0x06] = gpu.GPU2D_A.Enabled ? 1 : 0;
+    g[0x07] = gpu.GPU2D_B.Enabled ? 1 : 0;
+    memcpy(g + 0x08, gpu.VRAMCNT, 9);
+    g[0x11] = gpu.VRAMSTAT;
+    g[0x12] = gpu.CaptureEnable ? 1 : 0;
+    GXP32(g + 0x14, gpu.CaptureCnt);
+    memcpy(g + 0x18, gpu.DispFIFOBuffer, 256 * 2);
+
+    memcpy(s + 0x00400, gpu.Palette, 2 * 1024);
+    memcpy(s + 0x00C00, gpu.OAM, 2 * 1024);
+    memcpy(s + 0x01400, gpu.VRAMFlat_ABG, 512 * 1024);
+    memcpy(s + 0x81400, gpu.VRAMFlat_BBG, 128 * 1024);
+    memcpy(s + 0xA1400, gpu.VRAMFlat_AOBJ, 256 * 1024);
+    memcpy(s + 0xE1400, gpu.VRAMFlat_BOBJ, 128 * 1024);
+    memcpy(s + 0x101400, gpu.VRAMFlat_ABGExtPal, 32 * 1024);
+    memcpy(s + 0x109400, gpu.VRAMFlat_BBGExtPal, 32 * 1024);
+    memcpy(s + 0x111400, gpu.VRAMFlat_AOBJExtPal, 8 * 1024);
+    memcpy(s + 0x113400, gpu.VRAMFlat_BOBJExtPal, 8 * 1024);
+    memcpy(s + 0x115400, gpu.VRAM_A, 128 * 1024);
+    memcpy(s + 0x135400, gpu.VRAM_B, 128 * 1024);
+    memcpy(s + 0x155400, gpu.VRAM_C, 128 * 1024);
+    memcpy(s + 0x175400, gpu.VRAM_D, 128 * 1024);
+
+    GXLog::Dump2D(s, GX2D_STATE_SIZE);
+}
 
