# Ni no Kuni DS (B2KJ) — never commit game data.

# ROM images
*.nds
*.NDS
*.ds
*.zip
*.7z

# BIOS / firmware dumps
bios/
*.bin

# extracted / generated game data (binaries, overlays, FNT dumps, ...)
work/
extract/
out/
*.raw
*.elf

# Ghidra project databases + locks (analysis artifacts live in work/ghidra)
*.gpr
*.rep/
*.lock~
*.log.html
*.prp
*.lock.db

# Rust build output
nnktool/target/
target/

# Python
__pycache__/
*.pyc

# editor noise
*.swp
*~

worktrees/

# Phase-4G: build-state symlinks into the main checkout are not tracked
/work
/nnktool/target

# Screenshots of guest content (operator review only — never committed)
shots/

# never commit emulator states or decoded media (game data)
.worktrees/
*.ml8
*.mln
*.mods
*.yuv
*.nnks
