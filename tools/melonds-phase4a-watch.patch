+// ---------------------------------------------------------------------------
+// GX FIFO command-stream / frame capture (gxrender trace tooling).
+// Controlled by environment variables (all optional):
+//   MELONDS_GXLOG_DIR       output directory; unset -> capture disabled
+//   MELONDS_GXLOG_FRAMES    exit(0) after this many units (0 = run forever)
+//   MELONDS_GXLOG_FBDUMP    1 = dump f%05u.fb per unit (default 1)
+//   MELONDS_GXLOG_FBEVERY   dump the framebuffer every Nth unit (default 1)
+//   MELONDS_GXLOG_TEXEVERY  dump texture memory every Nth unit (default 1)
+//   MELONDS_GXLOG_TEXFROM   first unit to dump texture memory for (default 0)
+//   MELONDS_GXLOG_PACE      cap capture at N units/second (0 = unthrottled)
+//   MELONDS_GXLOG_PRESS     deterministic input schedule, semicolon-separated:
+//                             "1200:keys:fffb"    KEYINPUT mask at unit 1200
+//                             "1300:touch:128,96" touch screen at unit 1300
+//                             "1320:touch:up"     release touch at unit 1320
+//                           events are applied at the VBlank starting that
+//                           unit (unit 0 events at the first VBlank)
+// A "unit" is one emulated frame worth of GX traffic, delimited by VBlank().
+// Record format of f%05u.gx (little-endian):
+//   01 <u32 word>                       raw GX FIFO word
+//   02 <u8 width> <u32 addr> <u32 val>  3D MMIO write (width 1/2/4)
+//   03 <u8 cmd> <u32 param>             direct command-port write (440h-5CCh)
+// f%05u.fb      = 256*192 u32 pixels (r|g<<8|b<<16|a<<24, 6-bit rgb)
+// f%05u.texvram = 512 KiB flat texture VRAM
+// f%05u.texpal  = 128 KiB flat texture palette RAM
+// ---------------------------------------------------------------------------
+namespace GXLog
+{
+
+struct PressEvent
+{
+    int Unit;
+    int Type; // 0 = keys, 1 = touch, 2 = release touch
+    u32 A, B;
+};
+
+static bool Inited = false;
+static bool On = false;
+static char Dir[1024] = {};
+static std::vector<u8> RecBuf;
+static std::vector<PressEvent> Events;
+static size_t NextEvent = 0;
+static bool Injecting = false;
+static int Unit = 0;
+static int PendingFB = -1;
+static long FrameBudget = 0;
+static int FbDump = 1;
+static int FbEvery = 1;
+static int TexEvery = 1;
+static int TexFrom = 0;
+static int TwoDEvery = 0;
+static int TwoDFrom = 0;
+static long Pace = 0;
+// optional dump windows "a-b;c-d" (inclusive unit ranges): when set, ALL
+// per-unit dumps (.fb/.texvram/.texpal/.2d/.scr) are restricted to units in
+// any range; .gx streams always record.  Keeps multi-window validation runs
+// small.  Empty = no restriction (legacy behavior).
+static std::vector<std::pair<long, long>> DumpRanges;
+
+static bool InDumpRanges(long u) noexcept
+{
+    if (DumpRanges.empty()) return true;
+    for (const auto& r : DumpRanges)
+        if (u >= r.first && u <= r.second) return true;
+    return false;
+}
+
+static void Init() noexcept
+{
+    Inited = true;
+    const char* dir = getenv("MELONDS_GXLOG_DIR");
+    if (!dir || !dir[0]) return;
+    snprintf(Dir, sizeof(Dir), "%s", dir);
+    const char* s;
+    if ((s = getenv("MELONDS_GXLOG_FRAMES")))   FrameBudget = atol(s);
+    if ((s = getenv("MELONDS_GXLOG_FBDUMP")))   FbDump = atoi(s);
+    if ((s = getenv("MELONDS_GXLOG_FBEVERY")))  FbEvery = atoi(s) > 0 ? atoi(s) : 1;
+    if ((s = getenv("MELONDS_GXLOG_TEXEVERY"))) TexEvery = atoi(s) > 0 ? atoi(s) : 1;
+    if ((s = getenv("MELONDS_GXLOG_TEXFROM")))  TexFrom = atoi(s);
+    if ((s = getenv("MELONDS_GXLOG_2DEVERY")))  TwoDEvery = atoi(s) > 0 ? atoi(s) : 0;
+    if ((s = getenv("MELONDS_GXLOG_2DFROM")))   TwoDFrom = atoi(s);
+    if ((s = getenv("MELONDS_GXLOG_RANGES")))
+    {
+        char rbuf[1024];
+        snprintf(rbuf, sizeof(rbuf), "%s", s);
+        for (char* tok = strtok(rbuf, ";"); tok; tok = strtok(nullptr, ";"))
+        {
+            long a = 0, b = 0;
+            if (sscanf(tok, "%ld-%ld", &a, &b) == 2 && b >= a)
+                DumpRanges.emplace_back(a, b);
+        }
+    }
+    if ((s = getenv("MELONDS_GXLOG_PACE")))     Pace = atol(s);
+    if ((s = getenv("MELONDS_GXLOG_PRESS")))
+    {
+        char buf[4096];
+        snprintf(buf, sizeof(buf), "%s", s);
+        for (char* tok = strtok(buf, ";"); tok; tok = strtok(nullptr, ";"))
+        {
+            PressEvent ev = {};
+            char kind[16] = {};
+            char arg[64] = {};
+            if (sscanf(tok, "%d:%15[^:]:%63s", &ev.Unit, kind, arg) != 3)
+                continue;
+            if (!strcmp(kind, "keys"))
+            {
+                ev.Type = 0;
+                ev.A = (u32)strtoul(arg, nullptr, 16) & 0xFFF;
+            }
+            else if (!strcmp(kind, "touch"))
+            {
+                if (!strcmp(arg, "up")) ev.Type = 2;
+                else
+                {
+                    unsigned x = 0, y = 0;
+                    if (sscanf(arg, "%u,%u", &x, &y) != 2) continue;
+                    ev.Type = 1;
+                    ev.A = x;
+                    ev.B = y;
+                }
+            }
+            else continue;
+            Events.push_back(ev);
+        }
+        std::stable_sort(Events.begin(), Events.end(),
+            [](const PressEvent& a, const PressEvent& b) { return a.Unit < b.Unit; });
+    }
+    RecBuf.reserve(1 << 20);
+    On = true;
+}
+
+bool Active() noexcept { if (!Inited) Init(); return On; }
+bool InputLocked() noexcept { if (!Inited) Init(); return On && !Events.empty() && !Injecting; }
+int PendingUnit() noexcept { return PendingFB; }
+
+void Word(u32 val) noexcept
+{
+    if (!Active()) return;
+    RecBuf.push_back(0x01);
+    for (int i = 0; i < 4; i++) RecBuf.push_back((u8)(val >> (i * 8)));
+}
+
+void RegWrite(u32 addr, u32 val, int width) noexcept
+{
+    if (!Active()) return;
+    if (addr >= 0x04000440 && addr < 0x040005CC)
+    {
+        if (width != 4) return; // direct ports are 32-bit only
+        RecBuf.push_back(0x03);
+        RecBuf.push_back((u8)((addr & 0x1FC) >> 2));
+        for (int i = 0; i < 4; i++) RecBuf.push_back((u8)(val >> (i * 8)));
+        return;
+    }
+    if (addr != 0x04000060 && addr != 0x04000610 && (addr < 0x04000330 || addr >= 0x040003FF))
+        return; // not render-relevant
+    RecBuf.push_back(0x02);
+    RecBuf.push_back((u8)width);
+    for (int i = 0; i < 4; i++) RecBuf.push_back((u8)(addr >> (i * 8)));
+    for (int i = 0; i < 4; i++) RecBuf.push_back((u8)(val >> (i * 8)));
+}
+
+void CloseUnit(melonDS::NDS& nds) noexcept
+{
+    if (!Active()) return;
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/f%05d.gx", Dir, Unit);
+    FILE* f = fopen(path, "wb");
+    if (f)
+    {
+        if (!RecBuf.empty()) fwrite(RecBuf.data(), 1, RecBuf.size(), f);
+        fclose(f);
+    }
+    RecBuf.clear();
+    PendingFB = Unit;
+    Unit++;
+
+    // input events due at (the VBlank starting) this new unit
+    Injecting = true;
+    while (NextEvent < Events.size() && Events[NextEvent].Unit <= Unit)
+    {
+        const PressEvent& ev = Events[NextEvent++];
+        switch (ev.Type)
+        {
+        case 0: nds.SetKeyMask(ev.A); break;
+        case 1: nds.TouchScreen((u16)ev.A, (u16)ev.B); break;
+        case 2: nds.ReleaseScreen(); break;
+        }
+    }
+    Injecting = false;
+
+    if (Pace > 0)
+    {
+        static long long next = 0;
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        long long now = (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+        if (next == 0) next = now;
+        next += 1000000000LL / Pace;
+        if (next > now)
+        {
+            struct timespec sl;
+            sl.tv_sec = (time_t)((next - now) / 1000000000LL);
+            sl.tv_nsec = (long)((next - now) % 1000000000LL);
+            nanosleep(&sl, nullptr);
+        }
+        else
+            next = now; // fell behind; resync
+    }
+
+    if (FrameBudget > 0 && Unit >= FrameBudget)
+    {
+        fflush(nullptr);
+        exit(0);
+    }
+}
+
+void DumpFramebuffer(const u32* color, int stride, int firstpix, int w, int h) noexcept
+{
+    if (!Active() || !FbDump || PendingFB < 0) return;
+    if (!InDumpRanges(PendingFB)) return;
+    if (FbEvery > 1 && (PendingFB % FbEvery) != 0) return;
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/f%05d.fb", Dir, PendingFB);
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    for (int y = 0; y < h; y++)
+        fwrite(&color[firstpix + y * stride], 4, w, f);
+    fclose(f);
+}
+
+void DumpTextureMem(const u8* texvram, u32 texsize, const u8* texpal, u32 palsize) noexcept
+{
+    if (!Active() || PendingFB < 0 || PendingFB < TexFrom) return;
+    if (!InDumpRanges(PendingFB)) return;
+    if (TexEvery > 1 && (PendingFB % TexEvery) != 0) return;
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/f%05d.texvram", Dir, PendingFB);
+    FILE* f = fopen(path, "wb");
+    if (f) { fwrite(texvram, 1, texsize, f); fclose(f); }
+    snprintf(path, sizeof(path), "%s/f%05d.texpal", Dir, PendingFB);
+    f = fopen(path, "wb");
+    if (f) { fwrite(texpal, 1, palsize, f); fclose(f); }
+}
+
+// ---- 2D compositor state + final screens ---------------------------------
+// f%05u.2d container: "GX2D" <u32 ver=1> <u32 unit> <u32 flags> <u32 size>
+//   flags bit0 = keyframe
+//   keyframe payload: <size> raw state bytes
+//   delta payload:    <u32 nruns> { <u32 off> <u32 len> <len bytes> }*
+// The state image layout (little-endian, GX2D_STATE_SIZE bytes) is documented
+// in GX_TRACES.md and mirrored by gxrender/src/gx_2d.h (gx2d_state_load).
+
+static std::vector<u8> Prev2D;
+static bool HavePrev2D = false;
+
+void Dump2D(const void* state, u32 size) noexcept
+{
+    if (!Active() || TwoDEvery <= 0) return;
+    if (PendingFB < 0 || PendingFB < TwoDFrom) return;
+    if (!InDumpRanges(PendingFB)) return;
+    if (TwoDEvery > 1 && (PendingFB % TwoDEvery) != 0) return;
+
+    const u8* src = (const u8*)state;
+    bool keyframe = !HavePrev2D || Prev2D.size() != size;
+    std::vector<u8> payload;
+
+    if (!keyframe)
+    {
+        // one run per maximal contiguous changed region
+        std::vector<u8> body;
+        u32 nruns = 0;
+        u32 i = 0;
+        while (i < size)
+        {
+            if (src[i] == Prev2D[i]) { i++; continue; }
+            u32 start = i;
+            while (i < size && src[i] != Prev2D[i]) i++;
+            u32 len = i - start;
+            for (int b = 0; b < 4; b++) body.push_back((u8)(start >> (b * 8)));
+            for (int b = 0; b < 4; b++) body.push_back((u8)(len >> (b * 8)));
+            body.insert(body.end(), src + start, src + start + len);
+            nruns++;
+        }
+        if (body.size() + 4 > (size * 3) / 4) keyframe = true; // not worth it
+        else
+        {
+            for (int b = 0; b < 4; b++) payload.push_back((u8)(nruns >> (b * 8)));
+            payload.insert(payload.end(), body.begin(), body.end());
+        }
+    }
+    if (keyframe) payload.assign(src, src + size);
+
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/f%05d.2d", Dir, PendingFB);
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    u8 hdr[20] = { 'G', 'X', '2', 'D', 1, 0, 0, 0 };
+    u32 unit = (u32)PendingFB, flags = keyframe ? 1 : 0;
+    memcpy(&hdr[8], &unit, 4);
+    memcpy(&hdr[12], &flags, 4);
+    memcpy(&hdr[16], &size, 4);
+    fwrite(hdr, 1, 20, f);
+    if (!payload.empty()) fwrite(payload.data(), 1, payload.size(), f);
+    fclose(f);
+
+    Prev2D.assign(src, src + size);
+    HavePrev2D = true;
+}
+
+void DumpScreens(const void* fb0, const void* fb1) noexcept
+{
+    if (!Active() || TwoDEvery <= 0) return;
+    if (PendingFB < 0 || PendingFB < TwoDFrom) return;
+    if (!InDumpRanges(PendingFB)) return;
+    if (TwoDEvery > 1 && (PendingFB % TwoDEvery) != 0) return;
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/f%05d.scr", Dir, PendingFB);
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    fwrite(fb0, 4, 256 * 192, f);
+    fwrite(fb1, 4, 256 * 192, f);
+    fclose(f);
+}
+
+bool TwoDActive() noexcept { return Active() && TwoDEvery > 0; }
+
+}
