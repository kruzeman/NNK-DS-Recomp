+// ---------------------------------------------------------------------------
+namespace ARM9IOTrace
+{
+static FILE* FP = nullptr;
+static bool Tried = false;
+static long Limit = 200000;
+static long Count = 0;
+
+static inline bool Active() noexcept
+{
+    if (!Tried)
+    {
+        Tried = true;
+        const char* p = getenv("MELONDS_IOTRACE_PATH");
+        if (p && p[0])
+        {
+            FP = fopen(p, "w");
+            const char* s;
+            if (FP && (s = getenv("MELONDS_IOTRACE_N"))) Limit = atol(s);
+            if (Limit < 1) Limit = 1;
+            if (FP) setvbuf(FP, nullptr, _IOLBF, 0);
+        }
+    }
+    return FP != nullptr;
+}
+
+static void Log(const char* rw, u32 addr, u32 val, u32 pc) noexcept
+{
+    if (!Active()) return;
+    if (Count >= Limit) return;
+    fprintf(FP, "%s 0x%08X 0x%08X pc=0x%08X\n", rw, addr, val, pc);
+    if (++Count >= Limit) { fflush(FP); fclose(FP); FP = nullptr; }
+}
