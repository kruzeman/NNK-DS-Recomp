+// ---------------------------------------------------------------------------
+// ARM9 IO bus trace (Ni no Kuni DS static-recompilation verification).
+// Env-gated, completely inactive unless MELONDS_IOTRACE_PATH is set:
+//   MELONDS_IOTRACE_PATH  output file (unset -> disabled)
+//   MELONDS_IOTRACE_N     accesses to log (default 200000)
+// Format: one line per ARM9 IO bus access (0x04000000..0x04FFFFFF):
+//   R8|R16|R32 0x<addr> 0x<value> pc=0x<ARM9 PC-8/-4>
+//   W8|W16|W32 0x<addr> 0x<value> pc=0x<...>
+// The PC is the executed instruction (R[15]-8 ARM state / R[15]-4 Thumb),
+// same convention as the ARM9 PC trace hook in ARM.cpp.
+// ---------------------------------------------------------------------------
+namespace ARM9IOTrace
+{
+static FILE* FP = nullptr;
+static bool Tried = false;
+static long Limit = 200000;
+static long Count = 0;
+
+static inline bool Active() noexcept
+{
+    if (!Tried)
+    {
+        Tried = true;
+        const char* p = getenv("MELONDS_IOTRACE_PATH");
+        if (p && p[0])
+        {
+            FP = fopen(p, "w");
+            const char* s;
+            if (FP && (s = getenv("MELONDS_IOTRACE_N"))) Limit = atol(s);
+            if (Limit < 1) Limit = 1;
+            if (FP) setvbuf(FP, nullptr, _IOLBF, 0);
+        }
+    }
+    return FP != nullptr;
+}
+
+static void Log(const char* rw, u32 addr, u32 val, u32 pc) noexcept
+{
+    if (!Active()) return;
+    if (Count >= Limit) return;
+    fprintf(FP, "%s 0x%08X 0x%08X pc=0x%08X\n", rw, addr, val, pc);
+    if (++Count >= Limit) { fflush(FP); fclose(FP); FP = nullptr; }
+}
+}
+
 const s32 kMaxIterationCycles = 64;
 const s32 kIterationCycleMargin = 8;
 
