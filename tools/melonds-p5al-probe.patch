+// ---------------------------------------------------------------------------
+// ARM7 boot PC trace (Ni no Kuni DS static-recompilation verification).
+// Mirror of ARM9Trace for the ARM7 (ARMv4); env-gated, interpreter-only,
+// inactive unless MELONDS_ARM7TRACE_PATH is set:
+//   MELONDS_ARM7TRACE_PATH  output file (unset -> disabled)
+//   MELONDS_ARM7TRACE_N     PCs to log (default 1000000)
+//   MELONDS_ARM7TRACE_LO    window start (default 0x02000000)
+//   MELONDS_ARM7TRACE_HI    window end   (default 0x02400000, main RAM —
+//                           the ARM7 image runs at 0x02380000)
+//   MELONDS_ARM7TRACE_EXIT  1 = exit(0) once N PCs are logged (default 0)
+// Format: one "0x%08x" line per executed in-window instruction PC.
+// ---------------------------------------------------------------------------
+namespace ARM7Trace
+{
+static FILE* FP = nullptr;
+static bool Tried = false;
+static long Limit = 1000000;
+static long Count = 0;
+static bool ExitAtEnd = false;
+static u32 Lo = 0x02000000;
+static u32 Hi = 0x02400000;
+
+static void Init() noexcept
+{
+    Tried = true;
+    const char* p = getenv("MELONDS_ARM7TRACE_PATH");
+    if (!p || !p[0]) return;
+    FP = fopen(p, "w");
+    if (!FP) return;
+    const char* s;
+    if ((s = getenv("MELONDS_ARM7TRACE_N")))    Limit = atol(s);
+    if ((s = getenv("MELONDS_ARM7TRACE_LO")))   Lo = (u32)strtoul(s, nullptr, 0);
+    if ((s = getenv("MELONDS_ARM7TRACE_HI")))   Hi = (u32)strtoul(s, nullptr, 0);
+    if ((s = getenv("MELONDS_ARM7TRACE_EXIT"))) ExitAtEnd = atoi(s) != 0;
+    if (Limit < 1) Limit = 1;
+    setvbuf(FP, nullptr, _IOLBF, 0);
+}
+
+static void PC(u32 addr) noexcept
+{
+    if (!Tried) Init();
+    if (!FP) return;
+    if (addr < Lo || addr >= Hi) return;
+    if (Count >= Limit) return;
+
+    fprintf(FP, "0x%08x\n", addr);
+    if (++Count >= Limit)
+    {
+        fflush(FP);
+        fclose(FP);
+        FP = nullptr;
+        if (ExitAtEnd)
+        {
+            fflush(stderr);
+            exit(0);
+        }
+    }
+}
+}
