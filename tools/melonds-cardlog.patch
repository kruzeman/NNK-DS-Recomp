+// ---------------------------------------------------------------------------
+// Ni no Kuni DS Phase-4O: card-interface trace (game card ROMCTL/AUXSPICNT).
+// Env-gated, inactive unless MELONDS_CARDLOG_PATH is set.  One line per card
+// engine state change, timestamped with the ARM9 timestamp plus the ARM9 PC
+// that caused it (this is the "producer" measurement: who arms a transfer).
+// ---------------------------------------------------------------------------
+namespace CardLog
+{
+static FILE* FP = nullptr;
+static bool Tried = false;
+static long Reads = 0;
+
+static inline bool Active() noexcept
+{
+    if (!Tried)
+    {
+        Tried = true;
+        const char* p = getenv("MELONDS_CARDLOG_PATH");
+        if (p && p[0])
+        {
+            FP = fopen(p, "w");
+            if (FP) setvbuf(FP, nullptr, _IOLBF, 0);
+        }
+    }
+    return FP != nullptr;
+}
+
+static inline void Log(const char* fmt, ...) noexcept
+{
+    if (!Active()) return;
+    va_list ap; va_start(ap, fmt);
+    vfprintf(FP, fmt, ap);
+    va_end(ap);
+}
+}
